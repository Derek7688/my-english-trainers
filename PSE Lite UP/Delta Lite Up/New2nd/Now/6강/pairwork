 I often look for simple T-shirts and jeans.","followups":[{"en":"When do you usually buy clothes?","ko":"보통 언제 옷을 사요?","answer":"I usually shop on weekends.","answerKo":"보통 주말에 쇼핑해요."},{"en":"Where do you usually look for clothes?","ko":"옷을 주로 어디에서 찾아봐요?","answer":"I look for clothes on shopping apps.","answerKo":"쇼핑 앱에서 옷을 찾아봐요."},{"en":"Why do you like shopping there?","ko":"그곳에서 쇼핑하는 걸 왜 좋아해요?","answer":"Because it is easy and convenient.","answerKo":"쉽고 편리하기 때문이에요."},{"en":"How do you choose what to buy?","ko":"무엇을 살지 어떻게 골라요?","answer":"I check the price and the size.","answerKo":"가격과 사이즈를 확인해요."}],"answerKo":"보통 온라인으로 옷을 사요. 집에서 쇼핑하는 걸 좋아해요. 무난한 티셔츠와 청바지를 자주 찾아봐요."},{"category":"Planning My Day","en":"How do you plan your day?","ko":"하루 일정을 어떻게 계획해요?","answer":"I write a short list every morning. I check my important tasks first. This helps me stay organized.","followups":[{"en":"When do you usually plan your day?","ko":"보통 언제 하루 일정을 계획해요?","answer":"I usually plan it in the morning.","answerKo":"보통 아침에 계획해요."},{"en":"Where do you usually write down your plans?","ko":"계획을 주로 어디에 적어요?","answer":"I write them in my notebook.","answerKo":"노트에 적어요."},{"en":"Why do you like planning your day?","ko":"하루를 계획하는 걸 왜 좋아해요?","answer":"Because it helps me stay organized.","answerKo":"일정을 체계적으로 관리하는 데 도움이 되기 때문이에요."},{"en":"How do you choose what to do first?","ko":"무엇을 먼저 할지 어떻게 정해요?","answer":"I start with the most important task.","answerKo":"가장 중요한 일부터 시작해요."}],"answerKo":"매일 아침 짧은 목록을 써요. 중요한 일부터 확인해요. 이렇게 하면 일정을 체계적으로 관리할 수 있어요."},{"category":"My Favorite Season","en":"What is your favorite season?","ko":"가장 좋아하는 계절은 무엇이에요?","answer":"My favorite season is spring. The weather is warm and the flowers are pretty. I enjoy walking outside.","followups":[{"en":"When do you enjoy your favorite season the most?","ko":"가장 좋아하는 계절을 언제 가장 즐겨요?","answer":"I enjoy it in the middle of the season.","answerKo":"그 계절의 한가운데쯤 가장 즐겨요."},{"en":"Where do you like to go during that season?","ko":"그 계절에는 어디에 가는 걸 좋아해요?","answer":"I like going to parks.","answerKo":"공원에 가는 걸 좋아해요."},{"en":"Why is that your favorite season?","ko":"그 계절을 가장 좋아하는 이유는 뭐예요?","answer":"Because I like the weather.","answerKo":"날씨를 좋아하기 때문이에요."},{"en":"How do you enjoy that season?","ko":"그 계절을 어떻게 즐겨요?","answer":"I spend time outside and take photos.","answerKo":"밖에서 시간을 보내고 사진을 찍어요."}],"answerKo":"제가 가장 좋아하는 계절은 봄이에요. 날씨가 따뜻하고 꽃이 예뻐요. 밖에서 산책하는 걸 좋아해요."},{"category":"A Restaurant I Like","en":"What is your favorite restaurant?","ko":"가장 좋아하는 식당은 어디예요?","answer":"My favorite restaurant is a small Korean restaurant near my home. I often eat there with my friends. The food is delicious.","followups":[{"en":"When do you usually go to your favorite restaurant?","ko":"좋아하는 식당에 보통 언제 가요?","answer":"I usually go there on weekends.","answerKo":"보통 주말에 가요."},{"en":"Where is the restaurant?","ko":"그 식당은 어디에 있어요?","answer":"It is near my home.","answerKo":"집 근처에 있어요."},{"en":"Why do you like eating there?","ko":"그곳에서 식사하는 걸 왜 좋아해요?","answer":"Because the food is delicious.","answerKo":"음식이 맛있기 때문이에요."},{"en":"How do you usually get there?","ko":"그곳에 보통 어떻게 가요?","answer":"I usually walk there.","answerKo":"보통 걸어서 가요."}],"answerKo":"제가 가장 좋아하는 식당은 집 근처의 작은 한식당이에요. 친구들과 그곳에서 자주 식사해요. 음식이 맛있어요."}];
let deck=[],used=0,current=0,selected=-1,history=[],historyPos=-1;
const $=id=>document.getElementById(id);
function shuffle(a){a=[...a];for(let i=a.length-1;i>0;i--){let j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]]}return a}
function init(){deck=shuffle(TOPICS.map((_,i)=>i));used=0;history=[];historyPos=-1;drawNext()}
function drawNext(){if(historyPos<history.length-1){historyPos++;current=history[historyPos];selected=-1;render();return}if(used>=deck.length){deck=shuffle(TOPICS.map((_,i)=>i));used=0}current=deck[used++];history=history.slice(0,historyPos+1);history.push(current);historyPos=history.length-1;selected=-1;render()}
function goPrevious(){if(historyPos<=0)return;historyPos--;current=history[historyPos];selected=-1;render()}
function render(){
 const item=TOPICS[current];
 $('question').textContent=item.en;
 $('translation').textContent=item.ko;
 $('mainAnswer').textContent=item.answer+'\n'+item.answerKo;
 $('category').textContent=item.category.toUpperCase();
 $('qnum').textContent=`TOPIC ${String(historyPos+1).padStart(2,'0')} / ${TOPICS.length}`;
 const list=$('followList');list.innerHTML='';
 item.followups.forEach((f,i)=>{
  const b=document.createElement('button');
  b.className='follow'+(selected===i?' selected':'');
  const num=document.createElement('span');num.className='num';num.textContent=['WHEN','WHERE','WHY','HOW'][i];
  const text=document.createElement('span');text.className='ftext';text.append(document.createTextNode(f.en));
  const ko=document.createElement('span');ko.className='fko';ko.textContent=f.ko;text.appendChild(ko);
  if(selected===i){
   const answer=document.createElement('span');answer.className='follow-answer';
   const enAnswer=document.createElement('span');enAnswer.textContent=f.answer;
   const koAnswer=document.createElement('span');koAnswer.className='answer-ko';koAnswer.textContent=f.answerKo;
   answer.append(enAnswer,koAnswer);
   text.appendChild(answer);
  }
  b.append(num,text);
  b.setAttribute('aria-expanded',selected===i?'true':'false');
  b.onclick=()=>{selected=(selected===i?-1:i);render()};
  list.appendChild(b);
 });
 $('remaining').textContent=`아직 보지 않은 주제 ${Math.max(0,deck.length-used)}개`;
 $('previous').disabled=historyPos<=0;
 $('bar').style.width=`${used/deck.length*100}%`;
}
$('next').onclick=drawNext;$('previous').onclick=goPrevious;$('reshuffle').onclick=init;
$('startButton').onclick=()=>{$('startScreen').remove();document.body.classList.remove('not-started')};
init();
</script></body></html>
