<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>GM2 사다리 - Day 17 자료</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Pretendard:wght@400;700;900&display=swap');
        body { 
            font-family: 'Pretendard', sans-serif; 
            touch-action: manipulation; 
        }
        .auto-active { 
            background-color: #f97316 !important; 
            color: white !important; 
            border-color: #f97316 !important; 
        }
        .card-container { 
            min-height: 430px; 
            display: flex; 
            flex-direction: column; 
            justify-content: center; 
        }
        .banner-inner { transition: all 0.5s ease; }
        #progress-container { cursor: pointer; touch-action: none; }
        #prev-item-box { transition: all 0.5s ease; min-height: 48px; }
        .mode-btn-active { 
            background-color: #0f172a !important; 
            color: white !important; 
            border-color: #0f172a !important; 
        }
        
        /* ⏱ 자동 게이지 바 */
        #timer-gauge-bar {
            transition: width 50ms linear;
        }

        /* 🔤 자연스러운 줄바꿈 타이포그래피 규칙 */
        .natural-wrap {
            word-break: keep-all;
            overflow-wrap: break-word;
            text-wrap: balance;
            line-height: 1.55;
        }
    </style>
</head>
<body class="bg-slate-50 min-h-screen flex flex-col items-center justify-start p-4">

    <!-- 배너 템플릿 -->
    <template id="banner-template">
        <div class="promo-banner bg-white border border-blue-50 p-4 rounded-[2.2rem] mb-6 cursor-pointer shadow-lg transition-all active:scale-95 w-full max-w-sm mx-auto" 
             onclick="window.open('https://www.pse-learning.co.kr/course/course_list.jsp?cid=120849', '_blank')">
            <div class="banner-inner flex items-center gap-4">
                <div class="banner-icon w-10 h-10 bg-blue-600 rounded-2xl flex items-center justify-center text-xl shadow-blue-200 shadow-lg text-white font-bold">🔥</div>
                <div class="flex-1 overflow-hidden h-10 flex flex-col justify-center text-left">
                    <h3 class="banner-title font-black text-slate-800 text-[14px] tracking-tight leading-tight">하루 1분 투자! 실전 패턴 Pop!</h3>
                    <p class="text-blue-600 font-bold text-[9px] uppercase tracking-widest mt-0.5">수강 신청하고 영어 실력 Pop! →</p>
                </div>
            </div>
        </div>
    </template>

    <!-- [1] 설정 화면 -->
    <div id="setup-screen" class="bg-white p-8 rounded-[2.5rem] shadow-2xl max-w-sm w-full border border-slate-100 my-auto text-center">
        <span class="bg-indigo-100 text-indigo-600 px-4 py-1 rounded-full text-xs font-bold mb-3 inline-block uppercase tracking-widest">GM2 사다리</span>
        <h1 class="text-2xl font-black text-slate-800 mb-1">Day 17 자료</h1>
        <p id="setup-lesson-title" class="text-blue-600 font-bold text-lg italic mb-6 text-center w-full">실전 문형 Drilling! (총 53세트)</p>
        
        <div id="setup-banner-area"></div>

        <!-- 모드 선택 영역 -->
        <div class="mb-6 px-1">
            <p class="text-slate-700 font-bold text-sm mb-3 text-left">학습 모드 선택</p>
            <div class="grid grid-cols-2 gap-2 bg-slate-100 p-1.5 rounded-2xl">
                <button type="button" id="tab-ladder" onclick="selectPlayMode('ladder')" class="py-3 rounded-xl font-black text-xs transition-all mode-btn-active shadow-sm">
                    🪜 사다리 모드
                </button>
                <button type="button" id="tab-random" onclick="selectPlayMode('random')" class="py-3 rounded-xl font-bold text-xs text-slate-500 transition-all hover:text-slate-900">
                    🎲 랜덤 출제 모드
                </button>
            </div>
            <p id="mode-desc" class="text-[11px] font-semibold text-slate-400 mt-2 text-left px-1">설정한 단위만큼 누적해서 촘촘히 훈련합니다.</p>
        </div>

        <!-- 누적 반복 단위 (사다리 모드 전용) -->
        <div id="chunk-setting-box" class="mb-8 px-2 text-left transition-all">
            <div class="flex justify-between items-center mb-3">
                <p class="text-slate-700 font-bold text-sm">누적 반복 단위</p>
                <div class="bg-blue-600 text-white px-3 py-1 rounded-lg font-black text-xl" id="chunk-value">4</div>
            </div>
            <input type="range" id="chunk-slider" min="1" max="8" value="4" oninput="updateChunkDisplay(this.value)" class="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer accent-blue-600">
        </div>

        <div class="mb-6">
            <button id="auto-mode-btn" onclick="toggleAutoMode()" class="w-full py-4 rounded-2xl border-2 border-slate-100 font-bold text-slate-600 flex items-center justify-center gap-2 transition-all hover:bg-slate-50">
                <span id="auto-icon">⚪</span> 자동 재생 OFF
            </button>
        </div>
        <button onclick="startStudy()" class="w-full bg-slate-900 text-white py-5 rounded-2xl font-bold text-lg shadow-xl active:scale-95 transition-all">연습 시작하기</button>
    </div>

    <!-- [2] 학습 화면 -->
    <div id="study-screen" class="hidden w-full max-w-lg text-slate-900 mx-auto">
        <div class="flex justify-between items-center mb-4 px-2">
            <button onclick="location.reload()" class="p-2 hover:bg-slate-200 rounded-full transition-colors text-slate-400">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 001 1v4a1 1 0 001 1m-6 0h6" /></svg>
            </button>
            <div id="active-lesson-name" class="text-slate-400 font-black text-xs tracking-widest uppercase text-center flex-1">GM2 Day 17 자료</div>
            <div class="w-10"></div>
        </div>

        <!-- 직전 학습 문장 표시 영역 -->
        <div id="prev-item-box" class="w-full px-8 mb-2 flex flex-col items-center justify-center text-center opacity-0">
            <p id="prev-kr" class="text-xs font-bold text-slate-400 truncate w-full"></p>
            <p id="prev-en" class="text-xs font-black text-blue-300 truncate w-full"></p>
        </div>

        <div class="bg-white p-6 md:p-10 rounded-[3rem] shadow-2xl card-container text-center mb-6 border border-slate-50 relative overflow-hidden">
            <!-- ⏳ 자동 타이머 게이지 바 -->
            <div id="timer-gauge-container" class="absolute top-0 left-0 right-0 h-1.5 bg-slate-100 hidden overflow-hidden">
                <div id="timer-gauge-bar" class="h-full bg-orange-500 w-full"></div>
            </div>

            <div class="absolute top-6 left-8 right-8 flex justify-between items-center">
                <div class="flex items-center gap-1.5">
                    <span id="sentence-number" class="bg-slate-100 text-slate-500 px-3 py-1 rounded-lg text-[11px] font-black uppercase tracking-tighter">No.1</span>
                    <span id="speaker-badge" class="bg-indigo-600 text-white px-2.5 py-1 rounded-lg text-[10px] font-black uppercase tracking-tight">문장</span>
                </div>
                <div class="flex items-center gap-2">
                    <span id="badge-playmode" class="text-[9px] font-black px-2 py-0.5 rounded-full bg-blue-50 text-blue-600 uppercase tracking-tighter">사다리</span>
                    <button onclick="switchModeInGame()" id="mode-switch-btn" class="text-slate-300 font-bold text-[10px] underline decoration-slate-100 hover:text-blue-400 transition-colors">자동 모드 전환</button>
                    <div id="mode-status" class="text-[9px] font-black px-2 py-0.5 rounded-full bg-slate-50 text-slate-300 uppercase tracking-tighter transition-all">수동</div>
                </div>
            </div>

            <!-- 대화 맥락 영역 -->
            <div id="context-box" class="hidden mt-6 mb-5 p-4 bg-slate-50 border border-slate-100 rounded-2xl text-left transition-all space-y-2">
            </div>

            <!-- 현재 문제 한국어 -->
            <div class="flex items-start justify-center gap-2.5 mb-5 px-1 mt-6">
                <span id="role-tag" class="w-7 h-7 shrink-0 rounded-full bg-slate-900 text-white font-black text-xs flex items-center justify-center shadow-sm mt-0.5">A</span>
                <div id="kr-box" class="text-xl md:text-2xl font-black text-slate-800 natural-wrap text-center flex-1"></div>
            </div>

            <!-- 현재 문제 영어 정답 -->
            <div id="en-box" class="invisible opacity-0 translate-y-3 transition-all duration-300 w-full text-center">
                <div class="h-[1px] bg-slate-100 w-16 mx-auto mb-5"></div>
                <div id="en-text" class="text-xl md:text-2xl font-black text-blue-600 natural-wrap text-center px-2"></div>
            </div>

            <div id="finish-ui" class="hidden absolute inset-0 bg-white z-50 flex flex-col items-center justify-center p-6 text-center rounded-[3rem]">
                <p class="text-4xl mb-4">🎉</p>
                <h2 class="text-2xl font-black mb-2 text-slate-800">연습 완료!</h2>
                <div id="finish-banner-area" class="w-full"></div>
                <button id="cal-confirm-btn" class="w-full bg-blue-600 text-white py-4 rounded-2xl font-bold shadow-lg mb-2">복습 알림 예약하기</button>
                <button onclick="location.reload()" class="text-slate-400 text-sm font-bold py-2">그냥 종료하기</button>
            </div>
        </div>

        <div id="study-banner-area"></div>

        <div id="control-panel" class="flex flex-col gap-3 mb-6">
            <div class="flex gap-2">
                <button onclick="prevStep()" id="prev-btn" class="w-16 bg-white border-2 border-slate-100 text-slate-300 py-5 rounded-[1.8rem] font-black text-xl active:scale-95 transition-all">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M15 19l-7-7 7-7" /></svg>
                </button>
                <button onclick="handleAction()" id="main-btn" class="flex-1 bg-slate-900 text-white py-5 rounded-[1.8rem] font-black text-lg shadow-2xl active:scale-95 transition-all">정답 확인</button>
            </div>
        </div>

        <div id="progress-container" class="h-4 flex items-center w-full mb-2">
            <div class="h-1.5 w-full bg-slate-200 rounded-full overflow-hidden pointer-events-none">
                <div id="progress-bar" class="h-full bg-orange-500 transition-all duration-500" style="width: 0%"></div>
            </div>
        </div>
        <p id="progress-text" class="text-center text-slate-400 text-[9px] font-bold uppercase tracking-widest pb-6 pointer-events-none">Step 1 / 00</p>
    </div>

