            { num: "7", isDialogue: false, kr: "걔(남자), 대마초를 피워서 체포됐다면서.", en: "I heard he was arrested for smoking marijuana." },
            { num: "8", isDialogue: false, kr: "나 요즘 취업준비 하고 있어.", en: "I'm preparing to get a job these days." },
            { num: "9", isDialogue: false, kr: "나 요즘 토익시험 준비하고 있어.", en: "I'm preparing for the TOEIC these days." },
            { num: "10", isDialogue: false, kr: "내 친구 한 명이 날 배신해서 나 걔랑 인연 끊었어.", en: "I cut ties with one of my friends for betraying me." },
