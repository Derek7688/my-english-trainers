            // 41 ~ 46 (단일 문장)
            { num: "41", isDialogue: false, kr: "여기 오게 되어 기쁘다!", en: "(I’m) happy to be here!" },
            { num: "42", isDialogue: false, kr: "너 같은 친구가 있어서 행운이야.", en: "I’m lucky to have a friend like you." },
            { num: "43", isDialogue: false, kr: "이런 말해서 미안한데,", en: "I’m sorry to say this, but …" },
            { num: "44", isDialogue: false, kr: "나 혼자 여행을 하려니 무서워.", en: "I’m scared to go on a trip by myself." },
            { num: "45", isDialogue: false, kr: "가게 돼서 신나지 않아?", en: "Aren’t you excited to go?" },
            { num: "46", isDialogue: false, kr: "너 혼자 사려는 게 무섭지 않아?", en: "Aren’t you scared to live by yourself?" },

            // 47 (대화형)
            {
                num: "47", isDialogue: true,
                turns: [
                    { role: "A", kr: "너 모임에서 즐거운 시간 보냈어?", en: "Did you have a good time at the get-together?" },
                    { role: "B", kr: "네. 제 옛 친구들을 보게 되어 기뻤어요!", en: "Yes, I did. I was happy to see my old friends!" }
                ]
            }
        ];

        let playMode = 'ladder'; // 'ladder' | 'random'
        let studySequence = [], currentIdx = 0, selectedChunkSize = 4;
        let isAutoMode = false;
        let subStep = 0;

        let autoGaugeTimer = null;
        const THINK_TIME = 4500;
        const CONFIRM_TIME = 2800;

        const bannerMsgs = [
            { icon: "🔥", text: "하루 1분 투자! 실전 패턴 Pop!" },
            { icon: "🎬", text: "미드 보면서 실전 영어 패턴도 Pop!" }
        ];
        let currentBannerIdx = 0;

        function injectBanners() {
            const template = document.getElementById('banner-template').content;
            ['setup-banner-area', 'study-banner-area', 'finish-banner-area'].forEach(id => {
                const area = document.getElementById(id);
                if (area) area.appendChild(template.cloneNode(true));
            });
        }

        function rotateBanners() {
            currentBannerIdx = (currentBannerIdx + 1) % bannerMsgs.length;
            const msg = bannerMsgs[currentBannerIdx];
            document.querySelectorAll('.promo-banner').forEach(banner => {
                const inner = banner.querySelector('.banner-inner');
                if(!inner) return;
                inner.style.opacity = 0;
                inner.style.transform = "translateY(3px)";
                setTimeout(() => {
                    banner.querySelector('.banner-icon').innerText = msg.icon;
                    banner.querySelector('.banner-title').innerText = msg.text;
                    inner.style.opacity = 1;
                    inner.style.transform = "translateY(0)";
                }, 500);
            });
        }

        function selectPlayMode(mode) {
            playMode = mode;
            const ladderTab = document.getElementById('tab-ladder');
            const randomTab = document.getElementById('tab-random');
            const chunkBox = document.getElementById('chunk-setting-box');
            const modeDesc = document.getElementById('mode-desc');

            if (mode === 'ladder') {
                ladderTab.className = "py-3 rounded-xl font-black text-xs transition-all mode-btn-active shadow-sm";
                randomTab.className = "py-3 rounded-xl font-bold text-xs text-slate-500 transition-all hover:text-slate-900";
                chunkBox.classList.remove('hidden');
                modeDesc.innerText = "설정한 단위만큼 누적해서 촘촘히 훈련합니다.";
            } else {
                randomTab.className = "py-3 rounded-xl font-black text-xs transition-all mode-btn-active shadow-sm";
                ladderTab.className = "py-3 rounded-xl font-bold text-xs text-slate-500 transition-all hover:text-slate-900";
                chunkBox.classList.add('hidden');
                modeDesc.innerText = `${rawData.length}개 세트가 중복 없이 모두 끝날 때까지 무작위로 출제됩니다.`;
            }
        }

        function updateChunkDisplay(val) {
            selectedChunkSize = parseInt(val);
            document.getElementById('chunk-value').innerText = val;
        }

        function toggleAutoMode() {
            isAutoMode = !isAutoMode;
            const btn = document.getElementById('auto-mode-btn');
            btn.innerHTML = isAutoMode ? `<span>🟠</span> 자동 재생 ON` : `<span>⚪</span> 자동 재생 OFF`;
            btn.className = `w-full py-4 rounded-2xl border-2 font-bold flex items-center justify-center gap-2 transition-all ${isAutoMode ? 'auto-active' : 'border-slate-100 text-slate-600'}`;
        }

        function switchModeInGame() {
            isAutoMode = !isAutoMode;
            updateInGameModeUI();
            if(isAutoMode) {
                const isAnswerShowing = (subStep % 2 === 1);
                runAutoGauge(isAnswerShowing ? CONFIRM_TIME : THINK_TIME);
            } else {
                stopAutoGauge();
            }
        }

        function updateInGameModeUI() {
            const status = document.getElementById('mode-status');
            const switchBtn = document.getElementById('mode-switch-btn');
            if(isAutoMode) {
                status.innerText = "자동";
                status.className = "text-[9px] font-black px-2 py-0.5 rounded-full bg-orange-100 text-orange-600 uppercase tracking-tighter";
                switchBtn.innerText = "수동 전환";
            } else {
                status.innerText = "수동";
                status.className = "text-[9px] font-black px-2 py-0.5 rounded-full bg-slate-50 text-slate-300 uppercase tracking-tighter";
                switchBtn.innerText = "자동 전환";
            }
        }

        function runAutoGauge(duration) {
            stopAutoGauge();
            if (!isAutoMode) return;

            const container = document.getElementById('timer-gauge-container');
            const bar = document.getElementById('timer-gauge-bar');
            container.classList.remove('hidden');

            bar.style.transition = 'none';
            bar.style.width = '100%';

            const startTime = Date.now();
            const tickInterval = 50;

            requestAnimationFrame(() => {
                bar.style.transition = `width ${tickInterval}ms linear`;
            });

            autoGaugeTimer = setInterval(() => {
                const elapsed = Date.now() - startTime;
                const remaining = Math.max(0, duration - elapsed);
                const percent = (remaining / duration) * 100;
                bar.style.width = `${percent}%`;

                if (remaining <= 0) {
                    stopAutoGauge();
                    handleAction();
                }
            }, tickInterval);
        }

        function stopAutoGauge() {
            if (autoGaugeTimer) {
                clearInterval(autoGaugeTimer);
                autoGaugeTimer = null;
            }
            const container = document.getElementById('timer-gauge-container');
            const bar = document.getElementById('timer-gauge-bar');
            if (container) container.classList.add('hidden');
            if (bar) bar.style.width = '100%';
        }

        function shuffleArray(arr) {
            const copy = [...arr];
            for (let i = copy.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [copy[i], copy[j]] = [copy[j], copy[i]];
            }
            return copy;
        }

        function startStudy() {
            studySequence = [];
            
            if (playMode === 'ladder') {
                for (let i = 0; i < rawData.length; i += selectedChunkSize) {
                    let end = Math.min(i + selectedChunkSize - 1, rawData.length - 1);
                    for (let j = i; j <= end; j++) {
                        for (let k = i; k <= j; k++) studySequence.push({ data: rawData[k] });
                    }
                    if (end > i) {
                        for (let j = end; j >= i; j--) {
                            for (let k = end; k >= j; k--) studySequence.push({ data: rawData[k] });
                        }
                    }
                }
            } else {
                const shuffled = shuffleArray(rawData);
                studySequence = shuffled.map(item => ({ data: item }));
            }

            currentIdx = 0;
            subStep = 0;
            document.getElementById('badge-playmode').innerText = playMode === 'ladder' ? '사다리' : '랜덤';
            document.getElementById('setup-screen').classList.add('hidden');
            document.getElementById('study-screen').classList.remove('hidden');
            initProgressControl();
            updateInGameModeUI();
            render();
        }

        function render() {
            stopAutoGauge();
            const item = studySequence[currentIdx].data;
            
            // 직전 학습한 문제 요약
            const prevBox = document.getElementById('prev-item-box');
            if (currentIdx > 0) {
                const prevItem = studySequence[currentIdx - 1].data;
                if (prevItem.isDialogue) {
                    const lastTurn = prevItem.turns[prevItem.turns.length - 1];
                    document.getElementById('prev-kr').innerText = `Last: [${lastTurn.role}] ${lastTurn.kr.replace(/<[^>]*>/g, ' ')}`;
                    document.getElementById('prev-en').innerText = `[${lastTurn.role}] ${lastTurn.en.replace(/<[^>]*>/g, ' ')}`;
                } else {
                    document.getElementById('prev-kr').innerText = `Last: ${prevItem.kr.replace(/<[^>]*>/g, ' ')}`;
                    document.getElementById('prev-en').innerText = prevItem.en.replace(/<[^>]*>/g, ' ');
                }
                prevBox.classList.remove('opacity-0');
                prevBox.classList.add('opacity-40');
            } else {
                prevBox.classList.remove('opacity-40');
                prevBox.classList.add('opacity-0');
            }

            document.getElementById('sentence-number').innerText = `No.${item.num}`;
            document.getElementById('progress-text').innerText = `Set ${currentIdx + 1} / ${studySequence.length}`;
            document.getElementById('progress-bar').style.width = `${((currentIdx) / (studySequence.length - 1)) * 100}%`;

            const prevBtn = document.getElementById('prev-btn');
            if (currentIdx > 0 || subStep > 0) {
                prevBtn.classList.remove('text-slate-300', 'pointer-events-none');
                prevBtn.classList.add('text-slate-600');
            } else {
                prevBtn.classList.add('text-slate-300', 'pointer-events-none');
                prevBtn.classList.remove('text-slate-600');
            }

            const speakerBadge = document.getElementById('speaker-badge');
            const roleTag = document.getElementById('role-tag');
            const krBox = document.getElementById('kr-box');
            const enBox = document.getElementById('en-box');
            const enText = document.getElementById('en-text');
            const contextBox = document.getElementById('context-box');
            const mainBtn = document.getElementById('main-btn');

            if (item.isDialogue) {
                const turns = item.turns;
                const turnIdx = Math.floor(subStep / 2);
                const isAnswer = (subStep % 2 === 1);
                const currentTurn = turns[turnIdx];

                roleTag.classList.remove('hidden');
                roleTag.innerText = currentTurn.role;

                if (currentTurn.role === 'A') {
                    roleTag.className = "w-7 h-7 shrink-0 rounded-full bg-blue-600 text-white font-black text-xs flex items-center justify-center shadow-sm mt-0.5";
                    speakerBadge.innerText = `A 대화 (${turnIdx + 1}/${turns.length})`;
                    speakerBadge.className = "bg-blue-600 text-white px-2.5 py-1 rounded-lg text-[10px] font-black uppercase tracking-tight";
                } else {
                    roleTag.className = "w-7 h-7 shrink-0 rounded-full bg-orange-500 text-white font-black text-xs flex items-center justify-center shadow-sm mt-0.5";
                    speakerBadge.innerText = `B 답변 (${turnIdx + 1}/${turns.length})`;
                    speakerBadge.className = "bg-orange-500 text-white px-2.5 py-1 rounded-lg text-[10px] font-black uppercase tracking-tight";
                }

                if (turnIdx > 0) {
                    contextBox.innerHTML = turns.slice(0, turnIdx).map(t => {
                        const isA = (t.role === 'A');
                        return `<div>
                            <p class="text-xs md:text-sm font-bold ${isA ? 'text-slate-500' : 'text-slate-600'} natural-wrap"><span class="font-black text-slate-400">${t.role}:</span> ${t.kr}</p>
                            <p class="text-xs md:text-sm font-black ${isA ? 'text-blue-500' : 'text-orange-500'} natural-wrap"><span class="font-bold opacity-60">${t.role}:</span> ${t.en}</p>
                        </div>`;
                    }).join('');
                    contextBox.classList.remove('hidden');
                } else {
                    contextBox.classList.add('hidden');
                    contextBox.innerHTML = '';
                }

                krBox.innerHTML = currentTurn.kr;
                enText.innerHTML = currentTurn.en;

                if (!isAnswer) {
                    enBox.classList.add('invisible', 'opacity-0');
                    mainBtn.innerText = `${currentTurn.role} 정답 확인`;
                    if (isAutoMode) runAutoGauge(THINK_TIME);
                } else {
                    enBox.classList.remove('invisible', 'opacity-0');
                    const isLastTurn = (turnIdx === turns.length - 1);
                    mainBtn.innerText = isLastTurn ? "다음 세트 →" : "다음 대화 풀기 →";
                    if (isAutoMode) runAutoGauge(CONFIRM_TIME);
                }
            } else {
                contextBox.classList.add('hidden');
                roleTag.classList.add('hidden');
                speakerBadge.innerText = "문장";
                speakerBadge.className = "bg-indigo-600 text-white px-2.5 py-1 rounded-lg text-[10px] font-black uppercase tracking-tight";
                
                krBox.innerHTML = item.kr;
                enText.innerHTML = item.en;

                if (subStep === 0) {
                    enBox.classList.add('invisible', 'opacity-0');
                    mainBtn.innerText = "정답 확인";
                    if (isAutoMode) runAutoGauge(THINK_TIME);
                } else {
                    enBox.classList.remove('invisible', 'opacity-0');
                    mainBtn.innerText = "다음 세트 →";
                    if (isAutoMode) runAutoGauge(CONFIRM_TIME);
                }
            }
        }

        function handleAction() {
            stopAutoGauge();
            const item = studySequence[currentIdx].data;

            if (item.isDialogue) {
                const totalSubSteps = item.turns.length * 2;
                if (subStep < totalSubSteps - 1) {
                    subStep++;
                    render();
                } else {
                    currentIdx++;
                    subStep = 0;
                    if (currentIdx < studySequence.length) render();
                    else finishStudy();
                }
            } else {
                if (subStep === 0) {
                    subStep = 1;
                    render();
                } else {
                    currentIdx++;
                    subStep = 0;
                    if (currentIdx < studySequence.length) render();
                    else finishStudy();
                }
            }
        }

        function prevStep() {
            if (subStep > 0) {
                subStep--;
                render();
            } else if (currentIdx > 0) {
                currentIdx--;
                const prevItem = studySequence[currentIdx].data;
                subStep = prevItem.isDialogue ? (prevItem.turns.length * 2 - 1) : 1;
                render();
            }
        }

        function initProgressControl() {
            const container = document.getElementById('progress-container');
            const seek = (e) => {
                const rect = container.getBoundingClientRect();
                const x = (e.touches ? e.touches[0].clientX : e.clientX) - rect.left;
                let percent = x / rect.width;
                percent = Math.max(0, Math.min(1, percent));
                const newIdx = Math.round(percent * (studySequence.length - 1));
                if (newIdx !== currentIdx) {
                    currentIdx = newIdx;
                    subStep = 0;
                    render();
                }
            };
            container.addEventListener('mousedown', (e) => {
                seek(e);
                const onMouseMove = (moveEvent) => seek(moveEvent);
                const onMouseUp = () => {
                    document.removeEventListener('mousemove', onMouseMove);
                    document.removeEventListener('mouseup', onMouseUp);
                };
                document.addEventListener('mousemove', onMouseMove);
                document.addEventListener('mouseup', onMouseUp);
            });
            container.addEventListener('touchstart', (e) => {
                seek(e);
                const onTouchMove = (moveEvent) => {
                    moveEvent.preventDefault();
                    seek(moveEvent);
                };
                const onTouchEnd = () => {
                    document.removeEventListener('touchmove', onTouchMove);
                    document.removeEventListener('touchend', onTouchEnd);
                };
                document.addEventListener('touchmove', onTouchMove, { passive: false });
                document.addEventListener('touchend', onTouchEnd);
            });
        }

        function finishStudy() {
            stopAutoGauge();
            document.getElementById('finish-ui').classList.remove('hidden');
            document.getElementById('prev-item-box').classList.add('hidden');
            document.getElementById('study-banner-area').style.display = 'none';
            document.getElementById('control-panel').style.display = 'none';
            
            const btn = document.getElementById('cal-confirm-btn');
            btn.onclick = function() {
                const days = prompt("며칠 뒤에 복습 알림을 예약할까요? (1~30)", "1");
                if (!days) return;
                const targetDate = new Date();
                targetDate.setDate(targetDate.getDate() + parseInt(days));
                const dateStr = targetDate.toISOString().replace(/-|:|\.\d+/g, '').slice(0, 8);
                const modeName = playMode === 'ladder' ? '사다리 모드' : '랜덤 모드';
                const title = encodeURIComponent(`[복습] GM2 Day 17 (${modeName})`);
                const details = encodeURIComponent(`셀프 드릴링 복습하기!\n\n🔗 주소: ${window.location.href}`);
                location.href = `https://www.google.com/calendar/render?action=TEMPLATE&text=${title}&details=${details}&dates=${dateStr}T090000/${dateStr}T100000`;
            };
        }

        window.onload = () => {
            injectBanners();
            setInterval(rotateBanners, 4000);
        };
    </script>
</body>
</html>
